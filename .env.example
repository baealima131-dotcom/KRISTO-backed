# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/kristo
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/kristo?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=*

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/mpeg,video/quicktime

# Socket.io Configuration
SOCKET_CORS_ORIGIN=*
